# ============================================
# 小德社区后端 · 环境变量配置示例
# 复制为 .env 并按需修改（.env 不要提交到仓库）
#   cp .env.example .env
# ============================================

# ---- JWT 签名密钥（必填，上线前必须改成随机长字符串）----
# 生成方法：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
XIAODE_SECRET_KEY=please-change-me-to-a-random-long-string

# ---- 服务监听 ----
HOST=0.0.0.0
PORT=8000

# ---- 数据库 ----
# 默认 SQLite 单文件；换 PostgreSQL 时改这里
# SQLite:     sqlite:///./xiaode.db
# PostgreSQL: postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./xiaode.db

# ---- 邮件服务（用于注册/找回密码验证码）----
# 以 QQ 邮箱为例：需在邮箱设置中开启 SMTP 并获取「授权码」
XIAODE_SMTP_HOST=smtp.qq.com
XIAODE_SMTP_PORT=465
XIAODE_SMTP_USER=your@qq.com
XIAODE_SMTP_PASS=your-smtp-auth-code
XIAODE_SMTP_FROM=xiaode
