# ============================================================
# 小德社区 .gitignore
# ============================================================

# ---------- 签名密钥（最高优先级：泄露=别人可伪造你的 App）----------
*.keystore
*.jks
*.p12
*.pem
keystore.properties
signing.properties

# ---------- 本地配置（含密码/SDK 路径）----------
local.properties
gradle.properties.local
.env
.env.*
!.env.example
secrets.properties
private.properties

# ---------- 数据库（含真实用户数据）----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- 构建产物 ----------
build/
*/build/
.gradle/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar
.gradletasknamecache
captures/
.cxx/
release/
output/
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class
*.jar
!gradle-wrapper.jar
*.hprof
lint-results*.html
lint-results*.xml

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
*.launch
.navigation/
.DS_Store
Thumbs.db

# ---------- 日志 ----------
*.log
logs/
nohup.out

# ---------- 备份文件（项目中曾积累 200+ 个 .bak）----------
*.bak
*.bak.*
*.bak_*
*.old
*.orig
*.rej
*.swp
*~

# ---------- 临时文件 ----------
tmp/
temp/
*.tmp
.cache/

# ============ 后端相关 ============
backend/.env
backend/*.db
backend/*.db.*
backend/uploads/
backend/venv/
backend/__pycache__/

# ============ 签名与密钥 ============
xiaode.keystore
*.jks
*.keystore
local.properties

# ============ 构建产物 ============
*.apk
*.aab
*.ap_
app/build/
build/

# ============ 备份与临时 ============
*.bak
*.bak.*
.bak*/
.bak_*/
_backup_*/
.gradle/
patch*.py

# ============ 大图（源文件，非必需）============
icon_src.png
1791703374781.png

# ============ 编辑器 ============
.idea/
.vscode/
*.swp
.DS_Store
